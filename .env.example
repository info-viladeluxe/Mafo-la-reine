# ── Frontend (Vite, exposed to the browser) ─────────────────────────────────
# Supabase project (already has sensible fallbacks in src/lib/supabase.ts)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Flip a PSP on in the UI. The edge functions also need their own server-side
# secrets (see below) — these flags only control whether the provider card is
# shown as selectable in the SubscriptionGate.
VITE_STRIPE_ENABLED=true
VITE_FLUTTERWAVE_ENABLED=true
VITE_PAYUNIT_ENABLED=true
# Paystack is scaffolded (ProviderId, UI slot) but NOT wired up yet — there is
# no paystack-checkout/paystack-webhook edge function. Leave this false until
# those are built, following the flutterwave-checkout/-webhook pattern.
VITE_PAYSTACK_ENABLED=false

# ── Supabase Edge Functions secrets (set via `supabase secrets set`) ────────
# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxx
STRIPE_PRICE_FAMILY_MONTHLY=price_xxx
STRIPE_PRICE_FAMILY_YEARLY=price_xxx
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_PLUS_YEARLY=price_xxx

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-xxx  # optional

# PayUnit (https://gateway.payunit.net) — Basic auth (api_user/api_password)
# + x-api-key (application token) + mode (live|test). Set PAYUNIT_MODE to
# "test" while validating the integration in PayUnit's sandbox, and only
# switch to "live" once a real payment has round-tripped successfully.
PAYUNIT_API_USER=xxx
PAYUNIT_API_PASSWORD=xxx
PAYUNIT_API_KEY=live_xxx_or_test_xxx
PAYUNIT_MODE=test

# Paystack — NOT implemented yet (see VITE_PAYSTACK_ENABLED above). Placeholder
# names only, for whoever wires up paystack-checkout/paystack-webhook next.
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx
